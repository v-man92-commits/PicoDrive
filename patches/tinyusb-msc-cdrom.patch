diff --git a/src/class/msc/msc_device.c b/src/class/msc/msc_device.c
index dd66bfb6f..edaa13372 100644
--- a/src/class/msc/msc_device.c
+++ b/src/class/msc/msc_device.c
@@ -147,6 +147,27 @@ static inline uint16_t rdwr10_get_blocksize(msc_cbw_t const* cbw) {
   return (uint16_t) (cbw->total_bytes / block_count);
 }
 
+// DSpico image mounter addition: other block reads streamed like READ(10)
+static inline uint32_t stream_read_blocks(msc_cbw_t const* cbw) {
+  if (!tud_msc_stream_read_blocks_cb || SCSI_CMD_READ_10 == cbw->command[0] ||
+      !is_data_in(cbw->dir) || cbw->total_bytes == 0) {
+    return 0;
+  }
+  return tud_msc_stream_read_blocks_cb(cbw->lun, cbw->command, cbw->total_bytes);
+}
+
+static inline bool is_read_cmd(msc_cbw_t const* cbw) {
+  return SCSI_CMD_READ_10 == cbw->command[0] || stream_read_blocks(cbw) != 0;
+}
+
+static inline uint32_t read_blocksize(msc_cbw_t const* cbw) {
+  if (SCSI_CMD_READ_10 == cbw->command[0]) {
+    return rdwr10_get_blocksize(cbw);
+  }
+  uint32_t const blocks = stream_read_blocks(cbw);
+  return blocks ? cbw->total_bytes / blocks : 0;
+}
+
 static uint8_t rdwr10_validate_cmd(msc_cbw_t const* cbw) {
   uint8_t status = MSC_CSW_STATUS_PASSED;
   uint16_t const block_count = rdwr10_get_blockcount(cbw);
@@ -393,6 +414,9 @@ bool mscd_xfer_cb(uint8_t rhport, uint8_t ep_addr, xfer_result_t event, uint32_t
           // no data transfer, only exist in complaint test suite
           p_msc->stage = MSC_STAGE_STATUS;
         }
+      } else if (read_blocksize(p_cbw) != 0) {
+        // DSpico image mounter addition: READ(12) / READ CD etc. of any length
+        proc_read10_cmd(rhport, p_msc);
       } else {
         // For other SCSI commands
         // 1. OUT : queue transfer (invoke app callback after done)
@@ -447,7 +471,7 @@ bool mscd_xfer_cb(uint8_t rhport, uint8_t ep_addr, xfer_result_t event, uint32_t
       TU_LOG_DRV("  SCSI Data [Lun%u]\r\n", p_cbw->lun);
       //TU_LOG_MEM(MSC_DEBUG, _mscd_epbuf.buf, xferred_bytes, 2);
 
-      if (SCSI_CMD_READ_10 == p_cbw->command[0]) {
+      if (is_read_cmd(p_cbw)) {
         p_msc->xferred_len += xferred_bytes;
 
         if ( p_msc->xferred_len >= p_msc->total_len ) {
@@ -698,6 +722,17 @@ static int32_t proc_builtin_scsi(uint8_t lun, uint8_t const scsi_cmd[16], uint8_
     break;
 
     case SCSI_CMD_MODE_SENSE_6: {
+      // DSpico image mounter addition: refuse the disk geometry pages
+      // (format device 03h, rigid disk 04h, flexible disk 05h) like USB flash
+      // drives do. Answering them with the bare header below made BIOSes
+      // (e.g. SeaBIOS) read whatever followed it as cylinders/heads.
+      uint8_t const page = scsi_cmd[2] & 0x3F;
+      if (page == 0x03 || page == 0x04 || page == 0x05) {
+        tud_msc_set_sense(lun, SCSI_SENSE_ILLEGAL_REQUEST, 0x24, 0x00); // invalid field in CDB
+        resplen = -1;
+        break;
+      }
+
       scsi_mode_sense6_resp_t mode_resp =
       {
         .data_len = 3,
@@ -755,7 +790,7 @@ static void proc_read10_cmd(uint8_t rhport, mscd_interface_t* p_msc) {
   msc_cbw_t const* p_cbw = &p_msc->cbw;
 
   // block size already verified not zero
-  uint16_t const block_sz = rdwr10_get_blocksize(p_cbw);
+  uint32_t const block_sz = read_blocksize(p_cbw);
 
   // Adjust lba with transferred bytes
   uint32_t const lba = rdwr10_get_lba(p_cbw->command) + (p_msc->xferred_len / block_sz);
@@ -765,14 +800,20 @@ static void proc_read10_cmd(uint8_t rhport, mscd_interface_t* p_msc) {
 
   // Application can consume smaller bytes
   uint32_t const offset = p_msc->xferred_len % block_sz;
+  if (tud_msc_read_context_cb) {
