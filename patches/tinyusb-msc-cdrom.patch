+    if (p_msc->sense_key == 0) {
+      set_sense_medium_not_present(p_cbw->lun);
+    }
 
     fail_scsi_op(rhport, p_msc, MSC_CSW_STATUS_FAILED);
   } else if (nbytes == 0) {
